[TEMPLATE]
# ---- کپی کنید به .env و مقادیر را پر کنید (هرگز .env را در گیت نگذارید) ----

# Django
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# (اختیاری — پیش‌فرض: به‌صورت خودکار از ALLOWED_HOSTS ساخته می‌شود)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# PostgreSQL
POSTGRES_DB=nexify
POSTGRES_USER=nexify
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ایمیل (SMTP) — برای ارسال پیام‌های فرم تماس
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=no-reply@example.com
CONTACT_NOTIFY_EMAIL=amirrezahajiabadi480@gmail.com

# اعلان تلگرام (اختیاری — خالی = غیرفعال؛ بدون آن فرم/ثبت‌نام اعلان نمی‌فرستد)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
