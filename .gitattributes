# ============================================================
# .gitattributes — normalize line endings & protect binaries
# All text files are stored as LF in the repo (consistent with
# Linux deployment); Windows checkout still works fine.
# ============================================================

# Default: detect text files, store/checkout with LF
* text=auto eol=lf

# ---- Explicit text types (safety net for autodetection) ----
*.py        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.csv       text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.conf      text eol=lf
*.cfg       text eol=lf
*.svg       text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# ---- Windows scripts keep CRLF on checkout ----
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ---- Binary — git must never touch these ----
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.avif      binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.sqlite    binary
*.sqlite3   binary
*.db        binary
*.pyc       binary
