# ============================================================
# Root .gitignore — patterns apply to the WHOLE repo (any depth)
# Django-specific ignores live in Nexify/.gitignore
# ============================================================

# ---------- Freebuff workspace internals (logs, db, pids) — never commit ----------
.freebuff/

# ---------- Agent tooling (local-only, not part of the site) ----------
.agents/
.claude/
skills-lock.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
.env/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ---------- Node / frontend tooling (safety net) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.pnpm-store/
.yarn/
.eslintcache
.stylelintcache
.parcel-cache/
.vite/

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example

# ---------- Editors / IDEs ----------
.idea/
.vscode/
.fleet/
*.code-workspace
*.swp
*.swo
*~
.project
.classpath
.settings/
.nbproject/
.idea_modules/

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- Screenshot tooling (local Chrome profile) ----------
scripts/.chrome-profile/
